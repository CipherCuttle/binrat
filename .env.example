ARC_RPC_URL=
BINRAT_DB_PATH=./data/binrat.sqlite
BINRAT_CONFIRMATIONS=2
BINRAT_MAX_BATCH_BLOCKS=1000
BINRAT_POLL_MS=2000

# Telegram Rat runs as a separate read-only service against BINRAT's public API.
# Never commit real secret values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PORT=4175
TELEGRAM_MAX_MESSAGES_PER_MINUTE=12
TELEGRAM_REPLIES_ENABLED=false
TELEGRAM_REPLY_DB_PATH=./data/telegram-rat.sqlite
BINRAT_PUBLIC_BASE_URL=
BINRAT_PUBLIC_SITE_URL=

# Holder Gate V0 is deliberately fail-closed before canonical token authority exists.
# Do not set a token address or threshold until both are frozen and the balance source ships.
# Wallet-control endpoints and production token eligibility are separate, explicit gates.
BINRAT_HOLDER_WALLET_AUTH_ENABLED=false
BINRAT_HOLDER_GATE_ENABLED=false
