{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:binrat:workforce:v1:TOOL_MANIFEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tool",
    "authority",
    "effect",
    "charge",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "binrat.tool-manifest/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_:-]{1,100}$"
    },
    "tool": {
      "enum": [
        "READ_TRANSFER_FIXTURE",
        "READ_RECIPIENT_WINDOW_FIXTURE",
        "READ_PONS_LAUNCH_FIXTURE",
        "BUILD_CASE_DIFF",
        "DECIDE_ALERT"
      ]
    },
    "authority": {
      "const": {
        "research": true,
        "network": false,
        "provider": false,
        "delivery": false,
        "capital": false
      }
    },
    "effect": {
      "const": "DETERMINISTIC_FIXTURE_ONLY"
    },
    "charge": {
      "const": {
        "toolCalls": 1,
        "modelCalls": 0,
        "costMicrousd": 0
      }
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
