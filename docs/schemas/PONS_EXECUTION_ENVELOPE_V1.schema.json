{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:binrat:PONS_EXECUTION_ENVELOPE_V1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "binrat.pons-execution-envelope/1"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chainId": {
      "const": 4663
    },
    "from": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "not": {
        "const": "0x0000000000000000000000000000000000000000"
      }
    },
    "nonce": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "to": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "not": {
        "const": "0x0000000000000000000000000000000000000000"
      }
    },
    "calldata": {
      "type": "string",
      "pattern": "^0x969e6741([a-fA-F0-9]{2})+$"
    },
    "calldataHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "valueWei": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "gasLimit": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "maxFeePerGasWei": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "maxPriorityFeePerGasWei": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "approvedFeeCeilingWei": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "manifestDigest",
    "chainId",
    "from",
    "nonce",
    "to",
    "calldata",
    "calldataHash",
    "valueWei",
    "gasLimit",
    "maxFeePerGasWei",
    "maxPriorityFeePerGasWei",
    "approvedFeeCeilingWei",
    "createdAtMs",
    "expiresAtMs",
    "digest"
  ],
  "additionalProperties": false
}
